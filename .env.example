# Safe local emulator defaults (no real credentials).
# For hosted Vercel environments, set values directly in Vercel Project Settings.
HTOS_MODE=emulator
FIREBASE_PROJECT_ID=demo-htos
HTOS_CLOUD_PROJECT_ID=
FIRESTORE_EMULATOR_HOST=127.0.0.1:8085
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9095

VITE_HTOS_MODE=emulator
VITE_FIREBASE_PROJECT_ID=demo-htos
VITE_HTOS_CLOUD_PROJECT_ID=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
