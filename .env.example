HTOS_ENABLE_EMAIL=false
HTOS_ENABLE_OCR=false
HTOS_ENABLE_INVOICE_CASES=false
HTOS_ENABLE_INVOICE_READING=false
HTOS_ENABLE_HELP_AI=false