{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:menu",
  "outputDirectory": "dist-menu",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/((?!api/|assets/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    }
  ],
  "functions": {
    "api/**/*.ts": {
      "includeFiles": "{server/**,shared/**,api/**,constants.ts,types.ts,utils/supplierCatalogImport.ts,utils/invoiceReconciliation.ts,utils/deliveryScheduler.ts,utils/accessControl.ts,utils/creditClaimPdf.ts,utils/pdfTheme.ts,utils/pdfFonts.ts}",
      "maxDuration": 30
    }
  }
}
